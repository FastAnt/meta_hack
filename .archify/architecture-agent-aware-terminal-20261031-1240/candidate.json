  "cards": [
    {
      "dot": "cyan",
      "title": "Core principle: AI draws — code tells the truth",
      "items": [
        "Muse Image generates only the art layer: the world and the poster, no text",
        "Facts (components, connections, statistics) are computed by code from a real project index",
        "The poster is an anchored edit of the world: same islands, sunrise and confetti"
      ]
    },
    {
      "dot": "amber",
      "title": "Observation is separated from inference",
      "items": [
        "SessionObserver: OS facts from /proc (source=observed)",
        "The 'agent is working' heuristic is marked source=heuristic with confidence",
        "Exact events come from MuseAdapter reading Muse's own logs (source=agent_event)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Run it",
      "items": [
        "./dist/agent-aware-terminal/agent-aware-terminal — a plain GTK+VTE terminal",
        "Ctrl+Shift+O or auto-show — the overlay appears during long agent runs",
        "Menu: project, Muse task, Spark, history, poster; the key comes only from MODEL_API_KEY env"
      ]
    }
  ]
